# Server environment variables — copy to .env and fill in real values

PORT=5000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Local MongoDB (MongoDB Compass compatible)
MONGODB_URI=mongodb://127.0.0.1:27017/steel_business

# Atlas (cloud) — use this format if hosting remotely:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/steel_business?retryWrites=true&w=majority

# ─── Nodemailer SMTP ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Email where quote requests are delivered
MAIL_TO=your-business-email@gmail.com
MAIL_FROM=your-gmail@gmail.com

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
